# Normalize line endings for cross-platform development.
* text=auto

# Source and config files: LF everywhere.
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.lua text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Windows batch files keep CRLF.
*.bat text eol=crlf
